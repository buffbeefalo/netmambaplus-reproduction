# Hash-bound configuration, documents and records keep their committed bytes,
# including on checkouts with core.autocrlf enabled.
configs/** -text
docs/** -text
client/** -text
# Python source hashes also identify the implementation in calibration receipts.
*.py -text
# Preserve native warning whitespace and plotting-library SVG path formatting.
docs/customer/evidence/**/native.log -whitespace
docs/customer/evidence/calibration/seed*/*.log -whitespace
docs/customer/figures/*.svg -whitespace
docs/customer/audit-evidence/**/native.log -whitespace
# PDF syntax and compressed streams are binary even when Git's heuristic says text.
*.pdf binary
*.pptx binary
*.png binary
*.webm binary
